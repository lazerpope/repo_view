{
    "name": "repo_view",
    "version": "1.0.0",
    "description": "Project structure graph visualizer",
    "type": "module",
    "scripts": {
        "dev": "run-p dev:server dev:client",
        "dev:server": "node --watch backend/server.ts",
        "dev:client": "vite",
        "build": "pnpm type-check && vite build",
        "preview": "vite preview",
        "start:server": "node backend/server.ts",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "cook": "pnpm lint:fix && pnpm format"
    },
    "dependencies": {
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/controls": "^1.1.3",
        "@vue-flow/core": "^1.48.2",
        "vue": "^3.5.40"
    },
    "devDependencies": {
        "@eslint/css": "^2.0.0",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "npm-run-all2": "^9.0.2",
        "prettier": "^3.9.7",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.1.5",
        "vue-tsc": "^3.3.7"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.13.1",
    "engines": {
        "node": ">=24"
    }
}
