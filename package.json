{
  "name": "repo_view",
  "version": "1.0.0",
  "description": "Project structure graph visualizer",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:server": "node --watch backend/server.ts",
    "dev:client": "vite",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "start:server": "node backend/server.ts",
    "type-check": "vue-tsc --noEmit"
  },
    "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=24" }
}
